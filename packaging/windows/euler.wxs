<?xml version="1.0" encoding="utf-8"?>
<!-- WiX v4 安装器定义：安装到 Program Files，并创建桌面与开始菜单快捷方式。 -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Euler"
    Manufacturer="Euler"
    Version="$(var.Version)"
    UpgradeCode="5d0f3a52-1c4b-4f6e-9d7a-8c2b4e1f6a30"
    Scope="perMachine"
    Language="1033">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Euler is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="EulerIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="EulerIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/tanjhysj0/Euler" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Euler">
        <Component Id="MainExecutable" Guid="a3c1e6d4-7b92-4c58-8f10-2d6e9b4a7c51">
          <File Id="EulerExe" Source="$(var.ExePath)" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Euler">
        <Component Id="StartMenuShortcut" Guid="c7b2f8a1-4e63-4a90-b5d2-6f1c3e8a9d42">
          <Shortcut
            Id="StartMenuEuler"
            Name="Euler"
            Description="Euler local agent workspace"
            Target="[INSTALLFOLDER]euler.exe"
            Arguments="-open"
            WorkingDirectory="INSTALLFOLDER"
            Icon="EulerIcon" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue
            Root="HKCU"
            Key="Software\Euler"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="e9a4c2b7-5f18-4d36-9c08-7b3a1d5e6f24">
        <Shortcut
          Id="DesktopEuler"
          Name="Euler"
          Description="Euler local agent workspace"
          Target="[INSTALLFOLDER]euler.exe"
          Arguments="-open"
          WorkingDirectory="INSTALLFOLDER"
          Icon="EulerIcon" />
        <RegistryValue
          Root="HKCU"
          Key="Software\Euler"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Complete" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>
</Wix>
