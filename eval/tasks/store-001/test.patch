+package store
+
+import (
+	"sync"
+	"testing"
+)
+
+func TestConcurrentSetDelete(t *testing.T) {
+	s := New()
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func(worker int) {
+			defer wg.Done()
+			for j := 0; j < 200; j++ {
+				s.Set("key", worker+j)
+				s.Delete("key")
+			}
+		}(i)
+	}
+	wg.Wait()
+}
