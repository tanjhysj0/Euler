+package textutil
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestSplitEmptySep(t *testing.T) {
+	got := Split("a,b", "")
+	want := []string{"a", ",", "b"}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("Split = %v, want %v", got, want)
+	}
+}
+
+func TestSplitEmptySepUnicode(t *testing.T) {
+	got := Split("中文", "")
+	want := []string{"中", "文"}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("Split = %v, want %v", got, want)
+	}
+}
